NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Where viewpoint data comes from: "mock" (default: fixture data, no setup) or
# "supabase" (requires the two Supabase variables below).
NEXT_PUBLIC_DATA_SOURCE=mock

# Needed only when NEXT_PUBLIC_DATA_SOURCE=supabase. Ask the data owner for
# these values; never commit real ones.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=